generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum MealType {
  breakfast
  lunch
  dinner

  @@map("meal_type")
}

enum ChefPersonality {
  home
  french
  street

  @@map("chef_personality")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  name          String?
  image         String?
  isAdmin       Boolean   @default(false) @map("is_admin")

  unsubscribeToken    String?   @unique @map("unsubscribe_token")
  emailUnsubscribedAt DateTime? @map("email_unsubscribed_at")
  notifyMarketing     Boolean   @default(true) @map("notify_marketing")
  notifyProduct       Boolean   @default(true) @map("notify_product")

  pendingEmail      String?   @map("pending_email")
  emailChangeToken  String?   @unique @map("email_change_token")
  emailChangeExpiry DateTime? @map("email_change_expiry")

  sessionsRevokedAt DateTime? @map("sessions_revoked_at")

  // Forced password change — set true by admin action or a future compromised-
  // password flow; the (app)/(admin) layouts redirect here server-side (never
  // in middleware, which runs on Edge and can't hit Prisma for this check).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")

  // F30: Freemium gate
  isPro            Boolean   @default(false) @map("is_pro")
  recipeCount      Int       @default(0) @map("recipe_count")
  monthlyResetDate DateTime? @map("monthly_reset_date")

  // F53: Budget mode preference
  budgetMode Boolean @default(false) @map("budget_mode")

  // F70: Chef personality preference
  chefPersonality ChefPersonality @default(home) @map("chef_personality")

  // F74: Cooking method preference (stored as free-form string to avoid enum migrations when adding options)
  cookingMethod String @default("any") @map("cooking_method")

  // F78: Spice tolerance — 0=Mild, 1=Medium, 2=Hot, 3=Fire
  spiceLevel Int @default(0) @map("spice_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  recipes           Recipe[]
  mealPlans         MealPlan[]
  collections       RecipeCollection[]
  dietaryProfile    DietaryProfile?
  palateProfile     PalateProfile?
  pantryItems       PantryItem[]
  recipeCompletions RecipeCompletion[]

  @@index([email])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Recipe {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?     @db.Text
  servings    Int         @default(4)
  prepTimeMin Int?        @map("prep_time_min")
  cookTimeMin Int?        @map("cook_time_min")
  cuisine     String?
  difficulty  Difficulty?

  sourceIngredients String[] @map("source_ingredients")
  recipeData        Json     @map("recipe_data")
  rawText           String   @map("raw_text") @db.Text
  nutrition         Json?
  fromPhoto         Boolean  @default(false) @map("from_photo")
  modifications     Json     @default("[]")

  // F38: tagging
  tags String[] @default([])

  // F39: collections
  collectionId String?           @map("collection_id")
  collection   RecipeCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  // F41: completion tracking
  cookedCount  Int       @default(0) @map("cooked_count")
  lastCookedAt DateTime? @map("last_cooked_at")

  // F51: personal star rating (1–5), nullable = unrated
  rating Int? @map("rating")

  // F47: recipe completions (separate model for streak tracking)
  completions RecipeCompletion[]

  // F27: public sharing via permalink
  isPublic   Boolean @default(false) @map("is_public")
  publicSlug String? @unique @map("public_slug")

  // Allergen safety fields. Values are drawn from the canonical vocabulary in
  // src/lib/allergens.ts (FDA top-9 + EU-14 union). `allergens` is CONFIRMED
  // contains; `mayContain` is a weaker cross-contamination/ambiguous signal.
  // Never "free from X" — three-state honesty: contains / may contain / absent.
  //
  // These are a SINGLE paid-frontier-model annotation (2026-08-05; previously a
  // dual-model Azure + Opus agreement gate). They are NOT verified, and the
  // allergen disclaimer must render anywhere they are shown.
  allergens           String[]  @default([]) @map("allergens")
  mayContain          String[]  @default([]) @map("may_contain")
  allergenNotes       String?   @map("allergen_notes")
  // Renamed from allergenVerifiedAt when the dual-model gate was removed — it
  // records when annotation ran, NOT that anything was verified. The DB column
  // keeps its original name so no SQL migration is required.
  allergenAnnotatedAt DateTime? @map("allergen_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mealPlanSlots MealPlanSlot[]

  @@index([userId])
  @@index([collectionId])
  @@map("recipes")
}

// F47: per-day cooking log for streak and heatmap (separate from cookedCount on Recipe)
model RecipeCompletion {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  recipeId String   @map("recipe_id")
  cookedAt DateTime @default(now()) @map("cooked_at")

  // F88: post-cook feedback loop. Nullable — every pre-F88 row has no outcome,
  // and logging a cook without answering the prompt stays valid.
  outcome String? // "great" | "okay" | "failed"
  note    String? @db.Text
  aiTip   String? @map("ai_tip") @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId, cookedAt(sort: Desc)])
  @@index([recipeId])
  @@map("recipe_completions")
}

// F39: Recipe collections/folders
model RecipeCollection {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  color       String  @default("#22c55e") // default green

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipes Recipe[]

  @@index([userId])
  @@map("recipe_collections")
}

model MealPlan {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  weekStart DateTime       @map("week_start")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     MealPlanSlot[]

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("meal_plans")
}

model MealPlanSlot {
  id         String   @id @default(cuid())
  mealPlanId String   @map("meal_plan_id")
  dayOfWeek  Int      @map("day_of_week")
  mealType   MealType @map("meal_type")
  recipeId   String   @map("recipe_id")
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek, mealType])
  @@index([mealPlanId])
  @@index([recipeId])
  @@map("meal_plan_slots")
}

model JobRun {
  id         String    @id @default(cuid())
  job        String
  trigger    String    @default("cron")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  success    Boolean?
  result     Json?
  error      String?   @db.Text

  @@index([job, startedAt(sort: Desc)])
  @@map("job_runs")
}

model AdminScriptLog {
  id           String   @id @default(cuid())
  scriptName   String   @map("script_name")
  ranAt        DateTime @default(now()) @map("ran_at")
  ranByUserId  String?  @map("ran_by_user_id")
  rowsAffected Json?    @map("rows_affected")
  status       String
  errorMessage String?  @map("error_message")

  @@index([scriptName, ranAt(sort: Desc)])
  @@map("admin_script_logs")
}

// F31: Dietary profile — persisted per user, injected into every AI generation
model DietaryProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON arrays stored as String[] for Postgres native array support
  restrictions        String[] @default([]) // e.g. ["vegan", "gluten-free", "nut-allergy"]
  cuisinePrefs        String[] @default([]) @map("cuisine_prefs") // e.g. ["Italian", "Asian"]
  dislikedIngredients String[] @default([]) @map("disliked_ingredients")

  // F79: Medical dietary flags — general AI-generated guidance, NOT medical advice.
  lowSodium        Boolean @default(false) @map("low_sodium")
  lowFodmap        Boolean @default(false) @map("low_fodmap")
  diabetesFriendly Boolean @default(false) @map("diabetes_friendly")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dietary_profiles")
}

// F87: derived taste profile — computed from ratings/completions/modifications,
// not user-entered. Recomputed lazily on generate when >24h stale (no cron).
model PalateProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lovedFlavors       String[] @default([]) @map("loved_flavors")
  avoidedIngredients String[] @default([]) @map("avoided_ingredients")
  topCuisines        String[] @default([]) @map("top_cuisines")

  computedAt DateTime @default(now()) @map("computed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("palate_profiles")
}

model AICallLog {
  id           String   @id @default(cuid())
  site         String
  feature      String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  durationMs   Int?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([site])
  @@index([feature])
  @@index([userId])
  @@map("ai_call_logs")
}

// Cache for expensive AI outputs keyed by content hash. Eliminates unbounded
// free-tier LLM spend on repeated identical inputs (suggestion regenerations,
// re-uploaded fridge photos, repeat ingredient-comment requests).
model RecipeCache {
  id        String   @id @default(cuid())
  feature   String // 'suggestions' | 'photo' | 'comment'
  inputHash String
  output    Json // stored result (full JSON for non-streamed payloads)
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  lastHitAt DateTime @default(now())

  @@unique([feature, inputHash])
  @@index([feature, lastHitAt])
  @@map("recipe_caches")
}

// F44: Pantry inventory — persistent ingredient list tracked between sessions
// F26: expiresAt added for expiry-first mode
model PantryItem {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient String
  addedAt    DateTime  @default(now()) @map("added_at")
  expiresAt  DateTime? @map("expires_at") // nullable — not all items have an expiry date

  @@unique([userId, ingredient]) // prevent duplicate entries per user
  @@index([userId])
  @@map("pantry_items")
}

// Public ingredient reference corpus (allergen profile, substitutions, storage
// tips). Populated via scripts/seed-ingredient-ai.ts. Allergen-bearing fields
// (allergenProfile, hiddenSources, crossContamination, substitutions) are
// written only via scripts/lib/allergen-verify.ts, on a paid frontier model and
// never a free lane. They are a single model's annotation, NOT verified — see
// the Recipe model comment above for the same rule.
model Ingredient {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String
  description String? @db.Text

  // Confirmed-contains allergens, from src/lib/allergens.ts vocabulary.
  allergenProfile String[] @default([]) @map("allergen_profile")

  // List of { product, why } — products that commonly and non-obviously
  // contain this ingredient (e.g. "Worcestershire sauce" -> fish, anchovies).
  hiddenSources Json? @map("hidden_sources")

  // Free-text note on shared-equipment / cross-contamination risk.
  crossContamination String? @map("cross_contamination") @db.Text

  // List of { reason, substitute, ratio, notes } — reason values like
  // "peanut-free", "dairy-free".
  substitutions Json?

  storage     String?
  seasonality String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("ingredients")
}

// Public allergen reference — one row per canonical allergen token. `slug`
// values MUST match src/lib/allergens.ts ALLERGEN_VOCABULARY exactly; that
// file (not this table) is the single source of truth for the vocabulary,
// since Ingredient.allergenProfile / Recipe.allergens / Recipe.mayContain
// already link against it. This table adds encyclopedia-style content about
// each allergen itself (regulatory status, alternate label names, hidden
// sources, cross-reactivity, dining-out guidance) — it never redefines the
// vocabulary.
//
// HIGHEST-LIABILITY TABLE ON THE SITE (Phase 3 build, 2026-08-15). Rules that
// bind every value ever written here:
//   - Three-state language only — contains / may contain / absent. NEVER
//     "free from" in any field, anywhere this data is rendered.
//   - No medical thresholds (doses, trace amounts, ppm figures) and no
//     reaction-severity or likelihood claims. Severity is a medical question,
//     not a labeling one.
//   - Generated ONLY via scripts/lib/allergen-verify.ts's
//     verifyAllergenReference(), forced onto the paid Azure frontier model
//     (tier: 'quality', providers: ['azure']). That file's
//     requireVerifierEnv() throws when Azure creds are absent rather than
//     falling back to a free lane — there is no fallback path for this table,
//     by design.
//   - Output is a single model's guess and is NOT verified by a human or a
//     second model. `disclaimerVersion` records which disclaimer copy was in
//     force when the row was written, so a future wording change can be
//     audited against what a given row was published under.
//   - `published` defaults false on create (unlike Ingredient, which has no
//     publish gate) — given the liability here, seeding alone must never
//     make a row visible; an editor flips it after review.
model Allergen {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // { fda9: boolean, eu14: boolean, notes: string } — regulatory list
  // membership only. This is a factual "is this token on that list" flag,
  // not a presence/absence claim about any food.
  regulatoryStatus Json @map("regulatory_status")

  // Other names this allergen appears under on ingredient labels, e.g.
  // ["casein", "whey", "sodium caseinate"] for milk.
  alternateNames String[] @default([]) @map("alternate_names")

  // List of { product, why } — products that commonly and non-obviously
  // contain this allergen. Same shape as Ingredient.hiddenSources.
  hiddenSources Json? @map("hidden_sources")

  // Other foods/allergens commonly reported as cross-reactive with this one.
  // Framed as "commonly reported", never a guarantee or a diagnosis.
  crossReactivity String? @map("cross_reactivity") @db.Text

  // Practical menu-reading guidance for eating out. Never medical advice,
  // never a severity or threshold claim.
  diningOutGuidance String? @map("dining_out_guidance") @db.Text

  // Disclaimer copy version in force when this row was generated/last
  // written — see the model comment above.
  disclaimerVersion String @default("v1-2026-08-15") @map("disclaimer_version")

  published Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("allergens")
}
